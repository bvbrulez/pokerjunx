#!/bin/sh

set -eu

changelog="CHANGELOG.md"
if [ ! -f "$changelog" ]; then
  echo "pre-push: $changelog wurde nicht gefunden." >&2
  exit 1
fi

if ! git diff --quiet -- "$changelog" || ! git diff --cached --quiet -- "$changelog"; then
  echo "pre-push: Bitte eigene Änderungen an $changelog zuerst committen." >&2
  exit 1
fi

pending_messages=$(mktemp)
new_entries_file=$(mktemp)
trap 'rm -f "$pending_messages" "$new_entries_file"' EXIT

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in
    delete) continue ;;
  esac

  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    git log --format=%s --reverse "$local_sha" >>"$pending_messages"
  else
    git log --format=%s --reverse "$remote_sha..$local_sha" >>"$pending_messages"
  fi
done

while IFS= read -r message; do
  case "$message" in
    "chore: update changelog") continue ;;
  esac
  if ! grep -Fq -- "- $message" "$changelog"; then
    printf '%s\n' "- $message" >>"$new_entries_file"
  fi
done <"$pending_messages"

if [ ! -s "$new_entries_file" ]; then
  exit 0
fi

today_heading="## $(date +%Y-%m-%d)"
if grep -Fxq "$today_heading" "$changelog"; then
  awk -v heading="$today_heading" -v entries_file="$new_entries_file" '
    $0 == heading && !inserted {
      print
      print ""
      while ((getline line < entries_file) > 0) print line
      close(entries_file)
      inserted = 1
      next
    }
    { print }
  ' "$changelog" >"$changelog.tmp"
else
  awk -v heading="$today_heading" -v entries_file="$new_entries_file" '
    $0 == "# Änderungsprotokoll" && !inserted {
      print
      print ""
      print heading
      print ""
      while ((getline line < entries_file) > 0) print line
      close(entries_file)
      inserted = 1
      next
    }
    { print }
  ' "$changelog" >"$changelog.tmp"
fi
mv "$changelog.tmp" "$changelog"

git add "$changelog"
git commit -m "chore: update changelog"
echo "pre-push: CHANGELOG.md wurde aktualisiert. Bitte den Push erneut ausführen." >&2
exit 1
